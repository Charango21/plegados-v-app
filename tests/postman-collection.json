    {
      "name": "Flujo Completo",
      "item": [
        {
          "name": "1. Login CLIENTE",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function() { pm.response.to.have.status(200); var j = pm.response.json(); pm.collectionVariables.set('cliente_token', j.access); });"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/token/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"cliente\",\"password\":\"cliente1234\"}" }
          }
        },
        {
          "name": "2. Ver materiales",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function() { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/sheet-materials/",
            "header": [{ "key": "Authorization", "value": "Bearer {{cliente_token}}" }]
          }
        },
        {
          "name": "3. Crear pedido",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', function() { pm.response.to.have.status(200); var j = pm.response.json(); pm.collectionVariables.set('order_id', j.id); });"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{cliente_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"notes\":\"Flujo completo de prueba\"}" }
          }
        },
        {
          "name": "4. Agregar item al pedido",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', function() { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/order-items/",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{cliente_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"order\":\"{{order_id}}\",\"sheet_material\":1,\"width_mm\":\"600\",\"length_mm\":\"1200\",\"thickness_mm\":\"1.50\",\"shape\":\"Rectangular\",\"folds\":\"Doblez a 90 grados\"}" }
          }
        },
        {
          "name": "5. Verificar pedido con items",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function() { pm.response.to.have.status(200); var j = pm.response.json(); pm.expect(j.items).to.be.an('array').with.length.above(0); });"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}/",
            "header": [{ "key": "Authorization", "value": "Bearer {{cliente_token}}" }]
